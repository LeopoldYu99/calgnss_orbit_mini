[Unit]
Description=Orbit Prediction POSIX MQ service
After=dev-mqueue.mount
Requires=dev-mqueue.mount

[Service]
Type=simple
User=orbit
Group=orbit
EnvironmentFile=/etc/orbit-prediction.env
ExecStartPre=+/bin/sh -c 'test ! -e /dev/mqueue/csm_main_to_end0 || chmod 0666 /dev/mqueue/csm_main_to_end0; test ! -e /dev/mqueue/csm_end0_to_main || chmod 0666 /dev/mqueue/csm_end0_to_main'
ExecStart=/opt/orbit-prediction/bin/orbit_prediction_server
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0000

[Install]
WantedBy=multi-user.target
